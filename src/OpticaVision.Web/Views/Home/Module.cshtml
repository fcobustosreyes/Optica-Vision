@model ModulePageViewModel
@{
    var gestor = User.IsInRole("superadministrador") || User.IsInRole("administrador");
    var destinos = Model.Key switch {
        "inventario" when gestor || User.IsInRole("bodega") => new[]{"productos","categorias","marcas","bodegas","conteos_inventario"},
        "compras" or "ventas" or "proveedores" => new[]{Model.Key},
        "reportes" => new[]{"ventas","compras"},
        _ => Array.Empty<string>()
    };
    ViewData["Title"] = Model.Title;
    ViewData["ActivePage"] = Model.Key;
}

<section class="module-intro">
    <div>
        <p class="eyebrow">Gestión administrativa</p>
        <h1>@Model.Title</h1>
        <p class="date-line">@Model.Description</p>
    </div>
    <div class="button-row">@foreach(var tipo in destinos){
        <a class="secondary-button" asp-controller="Gestion" asp-action="Index" asp-route-tipo="@tipo">Gestionar @RecursosGestion.Todos[tipo].Titulo.ToLowerInvariant()</a>
    }</div>
</section>

@if (Model.Key == "citas")
{
    <a class="primary-button" asp-controller="Clientes" asp-action="Index">Elegir cliente para agendar</a>
    @if (TempData["CitaCreada"] is string mensaje) { <p role="status">@mensaje</p> }
}
<section class="panel list-panel">
    <div class="list-toolbar">
        <label class="search-box"><span aria-hidden="true">⌕</span><input type="search" placeholder="Buscar en @Model.Title.ToLowerInvariant()" aria-label="Buscar en @Model.Title" /></label>
        <span class="record-count">@Model.Rows.Count registros</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr>@foreach (var column in Model.Columns){<th>@column</th>}@if(Model.Key=="citas"){<th>Acciones</th>}</tr></thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        @for (var index = 0; index < Model.Columns.Count; index++)
                        {
                            var value = row[index];
                            var last = index == Model.Columns.Count - 1;
                            <td>
                                @if (last && (value is "Pendiente" or "Confirmada" or "Borrador" or "Reponer" or "Activo"))
                                {
                                    <span class="status-pill @value.ToLowerInvariant()">@value</span>
                                }
                                else { @value }
                            </td>
                        }
                        @if(Model.Key=="citas"){
                            <td>@if(row[5] is "Pendiente" or "Confirmada"){
                            <a asp-controller="Citas" asp-action="Crear" asp-route-id="@row[6]" asp-route-citaId="@row[7]">Editar cita</a>
                            <form method="post" asp-controller="Citas" asp-action="CambiarEstado" asp-route-id="@row[6]" asp-route-citaId="@row[7]">
                                @if(row[5]=="Pendiente"){<button class="text-button" name="estado" value="confirmada">Confirmar</button>}
                                <button class="text-button" name="estado" value="completada">Completar</button>
                                <button class="text-button" name="estado" value="cancelada">Cancelar cita</button>
                            </form>}</td>}
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="panel-foot" id="empty-results" hidden="@(Model.Rows.Count > 0)">Sin registros para mostrar.</p>
</section>
@section Scripts {
    <script>
        document.querySelector('.search-box input')?.addEventListener('input', (event) => {
            const term = event.target.value.toLocaleLowerCase('es');
            let count = 0;
            document.querySelectorAll('tbody tr').forEach((row) => {
                row.hidden = !row.textContent.toLocaleLowerCase('es').includes(term);
                if (!row.hidden) count++;
            });
            document.querySelector(".record-count").textContent = count + " registros";
            document.getElementById("empty-results").hidden = count > 0;
        });
    </script>
}



