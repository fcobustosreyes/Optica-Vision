@model ClienteRecord
@{
    ViewData["Title"] = "Detalle del cliente";
    ViewData["ActivePage"] = "clientes";
}
<section class="module-intro">
    <div><p class="eyebrow">Cliente @Model.Codigo</p><h1>@Model.Nombres @Model.Apellidos</h1><p class="date-line">Registro creado el @Model.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy")</p></div>
    <div class="button-row">
        @if (User.IsInRole("administrador") || User.IsInRole("superadministrador"))
        {
            <a class="secondary-button" asp-action="Editar" asp-route-id="@Model.Id">Editar</a>
        }
        <a class="secondary-button" asp-action="Index">Volver a clientes</a>
    </div>
</section>
<section class="panel detail-panel">
    <dl class="detail-grid">
        <div><dt>Estado</dt><dd>@(Model.Activo ? "Activo" : "Desactivado")</dd></div>
        <div><dt>Teléfono</dt><dd>@(Model.Telefono ?? "No registrado")</dd></div>
        <div><dt>Correo</dt><dd>@(Model.Correo ?? "No registrado")</dd></div>
        <div class="field-wide"><dt>Dirección</dt><dd>@(Model.Direccion ?? "No registrada")</dd></div>
    </dl>
</section>
