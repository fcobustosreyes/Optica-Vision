@model DashboardViewModel
@{
    ViewData["Title"] = "Inicio";
    ViewData["ActivePage"] = "inicio";
}

@if (User.IsInRole("superadministrador"))
{
    <section class="welcome-row">
        <div>
            <p class="eyebrow">Administraci&oacute;n de acceso</p>
            <h1>Panel de superadministraci&oacute;n</h1>
            <p class="date-line">Gestiona las cuentas y los permisos del sistema.</p>
        </div>
        <a class="primary-button" asp-controller="Usuarios" asp-action="Index">Gestionar usuarios</a>
    </section>
    <section class="notice-panel">
        <span class="notice-icon" aria-hidden="true">i</span>
        <div><strong>Acceso separado</strong><p>Este perfil administra usuarios. Las operaciones de clientes, ventas e inventario quedan reservadas al personal de la &oacute;ptica.</p></div>
    </section>
}
else if (User.IsInRole("cliente"))
{
    <section class="welcome-row">
        <div>
            <p class="eyebrow">Portal de clientes</p>
            <h1>Hola, @(User.Identity?.Name ?? "cliente")</h1>
            <p class="date-line">Tu cuenta no est&aacute; habilitada para este sistema administrativo.</p>
        </div>
    </section>
    <section class="notice-panel">
        <span class="notice-icon" aria-hidden="true">i</span>
        <div><strong>Acceso administrativo</strong><p>Solicita al personal de la &oacute;ptica la informaci&oacute;n sobre tus citas.</p></div>
    </section>
}
else
{
    <section class="welcome-row">
        <div>
            <p class="eyebrow">Resumen general de la &oacute;ptica</p>
            <h1>Buen d&iacute;a, @(User.Identity?.Name ?? "Usuario")</h1>
            <p class="date-line">@Model.Today</p>
        </div>
        @if (User.IsInRole("administrador") || User.IsInRole("ventas"))
        {
            <a class="primary-button" asp-controller="Home" asp-action="Module" asp-route-module="ventas"><span aria-hidden="true">+</span> Nueva venta</a>
        }
    </section>

    @if (User.IsInRole("administrador") || User.IsInRole("ventas"))
    {
        <section class="metric-grid" aria-label="Indicadores del d&iacute;a">
            @foreach (var metric in Model.Metrics)
            {
                <article class="metric-card accent-@metric.Accent">
                    <div class="metric-top"><span>@metric.Label</span><span class="metric-icon" aria-hidden="true">@metric.Icon</span></div>
                    <strong class="metric-value">@metric.Value</strong>
                    <span class="metric-detail">@metric.Detail</span>
                </article>
            }
        </section>
    }

    <section class="dashboard-grid">
        @if (User.IsInRole("administrador") || User.IsInRole("recepcion"))
        {
            <div class="panel appointments-panel">
                <div class="panel-heading">
                    <div><h2>Pr&oacute;ximas citas</h2><p>Agenda de hoy</p></div>
                    <a class="secondary-button" asp-controller="Home" asp-action="Module" asp-route-module="citas">Ver agenda <span aria-hidden="true">&rarr;</span></a>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Hora</th><th>Cliente</th><th>Tel&eacute;fono</th><th>Estado</th></tr></thead>
                        <tbody>
                            @foreach (var appointment in Model.Appointments)
                            {
                                <tr>
                                    <td class="time-cell">@appointment.Time</td>
                                    <td>@appointment.Client</td>
                                    <td class="muted-cell">@appointment.Phone</td>
                                    <td><span class="status-pill @appointment.Status.ToLowerInvariant()">@appointment.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="panel-foot">@Model.Appointments.Count registros <span>&bull;</span> Agenda</div>
            </div>
        }

    @if (User.IsInRole("administrador") || User.IsInRole("ventas") || User.IsInRole("bodega"))
        {
            <div class="panel stock-panel">
                <div class="panel-heading stock-heading"><div><h2>Pocas existencias</h2><p>M&iacute;nimo recomendado: 5 unidades</p></div></div>
                <ul class="stock-list">
                    @foreach (var product in Model.LowStock)
                    {
                        <li><span>@product.Product</span><strong>@product.Units unidades</strong></li>
                    }
                </ul>
                <a class="secondary-button stock-link" asp-controller="Home" asp-action="Module" asp-route-module="inventario">Ir al inventario <span aria-hidden="true">&rarr;</span></a>
            </div>
        }
    </section>
}
