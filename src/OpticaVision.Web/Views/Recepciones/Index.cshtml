@model RecepcionesViewModel
@{
    ViewData["Title"] = "Recepciones";
    ViewData["ActivePage"] = "recepciones";
}

<section class="module-intro">
    <div>
        <p class="eyebrow">Bodega · entradas de inventario</p>
        <h1>Recepciones</h1>
        <p class="date-line">Consulta las entradas recibidas, su bodega y las unidades ingresadas.</p>
    </div>
</section>

<section class="panel list-panel">
    <form method="get" class="list-toolbar">
        <label class="search-box"><span aria-hidden="true">&#9906;</span><input type="search" name="buscar" value="@Model.Busqueda" placeholder="Buscar proveedor, bodega o producto" /></label>
        <span class="record-count">@Model.Recepciones.Count registros</span>
    </form>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Recepci&oacute;n</th><th>Fecha</th><th>Proveedor</th><th>Bodega</th><th>Productos</th><th>Unidades</th><th>Estado</th><th>Responsable</th></tr></thead>
            <tbody>
                @if (Model.Recepciones.Count == 0)
                {
                    <tr><td class="empty-cell" colspan="8">No hay recepciones que coincidan con la b&uacute;squeda.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Recepciones)
                    {
                        <tr>
                            <td class="time-cell">REC-@item.Id.ToString("D5")</td>
                            <td>@item.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.Proveedor</td>
                            <td>@item.Bodega</td>
                            <td>@item.Productos</td>
                            <td>@item.Unidades</td>
                            <td><span class="status-pill @item.Estado.ToLowerInvariant()">@item.Estado</span></td>
                            <td>@item.Responsable</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="panel-foot">Mostrando hasta 200 recepciones recientes.</div>
</section>
