@model CitaForm
@{
    ViewData["Title"] = ViewData["CitaId"] is null ? "Agendar cita" : "Editar cita";
    ViewData["ActivePage"] = "citas";
}
<section class="module-intro"><div><p class="eyebrow">Agenda</p><h1>@ViewData["Title"]</h1><p>@ViewData["Cliente"]</p></div></section>
<section class="panel form-panel">
    <form asp-action="Crear" asp-route-citaId='@ViewData["CitaId"]' asp-route-id='@ViewData["ClienteId"]' method="post">
        <div class="form-grid">
            <div class="field"><label asp-for="OftalmologoId"></label><select asp-for="OftalmologoId" required><option value="">Seleccionar oftalmólogo</option>@foreach(var medico in (Dictionary<long,string>)ViewData["Oftalmologos"]!){<option value="@medico.Key">@medico.Value</option>}</select><span asp-validation-for="OftalmologoId"></span></div>
            <div class="field"><label asp-for="Fecha"></label><input asp-for="Fecha" type="datetime-local" required /><span asp-validation-for="Fecha"></span></div>
            <div class="field"><label asp-for="Servicio"></label><select asp-for="Servicio" required><option value="">Seleccionar servicio</option>@foreach(var servicio in (IEnumerable<string>)(ViewData["Servicios"] ?? Array.Empty<string>())){<option value="@servicio">@servicio</option>}</select><span asp-validation-for="Servicio"></span></div>
        </div>
        <div class="form-actions"><a class="secondary-button" asp-controller="Clientes" asp-action="Detalles" asp-route-id='@ViewData["ClienteId"]'>Cancelar</a><button class="primary-button">Guardar cita</button></div>
    </form>
</section>



