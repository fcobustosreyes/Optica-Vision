@model LoginForm
@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar sesión · Óptica Visión</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <main class="auth-card">
        <span class="brand-mark">OV</span>
        <p class="eyebrow">Óptica Visión</p>
        <h1>Iniciar sesión</h1>
        <p class="auth-description">Accede con la cuenta que te asignó la óptica.</p>
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="success-message" role="status">@mensaje</div>
        }
        <form method="post" asp-controller="Cuenta" asp-action="IniciarSesion">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input asp-for="Retorno" type="hidden" />
            <div class="field"><label asp-for="Correo"></label><input asp-for="Correo" autocomplete="username" inputmode="email" /><span asp-validation-for="Correo"></span></div>
            <div class="field"><label asp-for="Contrasena"></label><input asp-for="Contrasena" autocomplete="current-password" /><span asp-validation-for="Contrasena"></span></div>
            <button class="primary-button auth-submit" type="submit">Entrar</button>
        </form>
        <p class="auth-footnote">La contraseña se verifica con Supabase Auth. No se guarda en esta aplicación.</p>
    </main>
</body>
</html>
