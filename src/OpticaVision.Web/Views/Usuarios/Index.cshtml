@using OpticaVision.Web.Auth
@model IReadOnlyList<PerfilLista>
@{
    ViewData["Title"] = "Usuarios";
    ViewData["ActivePage"] = "usuarios";
}
<section class="module-intro"><div><p class="eyebrow">Administración de acceso</p><h1>Usuarios</h1><p class="date-line">Asigna roles y conserva el historial al desactivar cuentas.</p></div><a class="primary-button" asp-action="Crear">+ Nuevo usuario</a></section>
@if (TempData["Mensaje"] is string mensaje) { <div class="success-message" role="status">@mensaje</div> }
@if (TempData["Error"] is string error) { <div class="validation-summary" role="alert">@error</div> }
<section class="panel list-panel"><div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach (var perfil in Model)
{
    <tr><td>@perfil.NombreCompleto</td><td>@perfil.Correo</td><td>@perfil.Rol</td><td><span class="status-pill @(perfil.Activo ? "activo" : "cancelada")">@(perfil.Activo ? "Activo" : "Desactivado")</span></td><td class="action-cell">
    @if (perfil.PerfilId != Guid.Parse(User.FindFirst("optica:perfil_id")!.Value) && (User.IsInRole("superadministrador") || perfil.Rol is "recepcion" or "ventas" or "bodega"))
    {
        <form method="post" asp-action="@(perfil.Activo ? "Desactivar" : "Reactivar")" asp-route-perfilId="@perfil.PerfilId"><button class="text-button" type="submit">@(perfil.Activo ? "Desactivar" : "Reactivar")</button></form>
    }
    </td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="5" class="empty-cell">No hay perfiles registrados.</td></tr> }
</tbody></table></div><div class="panel-foot">Las cuentas desactivadas permanecen en el historial y pierden acceso.</div></section>

