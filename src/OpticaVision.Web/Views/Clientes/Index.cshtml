@model ClientesIndexViewModel
@{
    ViewData["Title"] = "Clientes";
    ViewData["ActivePage"] = "clientes";
}

<section class="module-intro">
    <div>
        <p class="eyebrow">Gestión administrativa</p>
        <h1>Clientes</h1>
        <p class="date-line">Consulta y administra los datos de contacto necesarios para atenderlos.</p>
    </div>
    <a class="primary-button" asp-action="Crear">+ Nuevo cliente</a>
</section>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="notice-panel" role="status"><span class="notice-icon">✓</span><div>@mensaje</div></div>
}

<section class="panel list-panel">
    <form class="list-toolbar" method="get" asp-action="Index">
        <label class="search-box"><span aria-hidden="true">⌕</span><input type="search" name="buscar" value="@Model.Busqueda" placeholder="Buscar por nombre, código o contacto" /></label>
        <label class="filter-check"><input type="checkbox" name="incluirInactivos" value="true" checked="@Model.IncluirInactivos" /> Incluir desactivados</label>
        <button class="secondary-button" type="submit">Buscar</button>
        <span class="record-count">@Model.Clientes.Count registros</span>
    </form>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Código</th><th>Nombre</th><th>Teléfono</th><th>Correo</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody>
            @foreach (var cliente in Model.Clientes)
            {
                <tr>
                    <td>@cliente.Codigo</td>
                    <td>@cliente.Nombres @cliente.Apellidos</td>
                    <td>@(cliente.Telefono ?? "—")</td>
                    <td>@(cliente.Correo ?? "—")</td>
                    <td><span class="status-pill @(cliente.Activo ? "activo" : "cancelada")">@(cliente.Activo ? "Activo" : "Desactivado")</span></td>
                    <td class="action-cell">
                        <a asp-action="Detalles" asp-route-id="@cliente.Id">Ver</a>
                        @if (User.IsInRole("administrador") || User.IsInRole("superadministrador"))
                        {
                            <a asp-action="Editar" asp-route-id="@cliente.Id">Editar</a>
                            <form method="post" asp-action="@(cliente.Activo ? "Desactivar" : "Reactivar")" asp-route-id="@cliente.Id">
                                <button class="text-button" type="submit">@(cliente.Activo ? "Desactivar" : "Reactivar")</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Clientes.Count == 0)
            {
                <tr><td colspan="6" class="empty-cell">No hay clientes que coincidan con la búsqueda.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="panel-foot">Máximo 250 resultados por consulta. Los registros desactivados se conservan.</div>
</section>
