@{
    var activePage = ViewData["ActivePage"]?.ToString() ?? "inicio";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Usuario";
    var navigation = new[]
    {
        ("inicio", "Inicio", "M3 10 12 3l9 7v11h-6v-7H9v7H3z"),
        ("citas", "Citas", "M3 6h18v15H3z M7 3v6m10-6v6M3 11h18"),
        ("ventas", "Ventas", "M2 4h3l3 12h11l3-9H6 M9 20h2m6 0h2"),
        ("compras", "Compras", "M3 8h18v13H3z M8 8V4h8v4 M12 11v7m-3-4h6"),
        ("inventario", "Inventario", "m3 7 9-5 9 5v10l-9 5-9-5z M3 7l9 5 9-5m-9 5v10"),
        ("recepciones", "Recepciones", "M3 14v7h18v-7 M12 2v13m-5-5 5 5 5-5"),
        ("kardex", "Kardex", "M4 3h16v18H4z M8 8h8m-8 4h8m-8 4h5"),
        ("clientes", "Clientes", "M16 8a4 4 0 1 1-8 0 4 4 0 0 1 8 0 M4 21v-2a8 6 0 0 1 16 0v2"),
        ("proveedores", "Proveedores", "M2 21V6l10-3v18m0-13 9 3v10M2 21h20M5 9h3m-3 4h3m7 1h3"),
        ("reportes", "Reportes", "M3 3v18h18M7 17v-5m5 5V7m5 10V4")
    };
    var allowedPages = role switch
    {
        "administrador" => new[] { "inicio", "citas", "ventas", "compras", "inventario", "recepciones", "kardex", "clientes", "proveedores", "reportes" },
        "ventas" => new[] { "inicio", "ventas", "inventario", "clientes" },
        "recepcion" => new[] { "inicio", "citas", "clientes" },
        "bodega" => new[] { "inicio", "recepciones", "inventario", "kardex" },
        _ => new[] { "inicio" }
    };
    navigation = navigation.Where(item => allowedPages.Contains(item.Item1)).ToArray();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#173e61" />
    <title>@ViewData["Title"] · Óptica Visión</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar" aria-label="Navegación principal">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Óptica Visión, inicio">
                <span class="brand-mark">OV</span><span class="brand-name">Óptica Visión</span>
            </a>
            <p class="sidebar-caption">Gestión administrativa</p>
            <nav class="main-nav">
                @foreach (var item in navigation)
                {
                    var current = activePage == item.Item1;
                    if (item.Item1 == "inicio")
                    {
                        <a class="nav-link @(current ? "active" : "")" asp-controller="Home" asp-action="Index" aria-label="@item.Item2" aria-current="@(current ? "page" : null)">
                            <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="@item.Item3" /></svg></span><span>@item.Item2</span>
                        </a>
                    }
                    else if (item.Item1 == "clientes")
                    {
                        <a class="nav-link @(current ? "active" : "")" asp-controller="Clientes" asp-action="Index" aria-label="@item.Item2" aria-current="@(current ? "page" : null)">
                            <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="@item.Item3" /></svg></span><span>@item.Item2</span>
                        </a>
                    }
                    else if (item.Item1 == "recepciones")
                    {
                        <a class="nav-link @(current ? "active" : "")" asp-controller="Recepciones" asp-action="Index" aria-label="@item.Item2" aria-current="@(current ? "page" : null)">
                            <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="@item.Item3" /></svg></span><span>@item.Item2</span>
                        </a>
                    }
                    else if (item.Item1 == "kardex")
                    {
                        <a class="nav-link @(current ? "active" : "")" asp-controller="Kardex" asp-action="Index" aria-label="@item.Item2" aria-current="@(current ? "page" : null)">
                            <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="@item.Item3" /></svg></span><span>@item.Item2</span>
                        </a>
                    }
                    else
                    {
                        <a class="nav-link @(current ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-module="@item.Item1" aria-label="@item.Item2" aria-current="@(current ? "page" : null)">
                            <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="@item.Item3" /></svg></span><span>@item.Item2</span>
                        </a>
                    }
                }
                @if (User.IsInRole("superadministrador") || User.IsInRole("administrador"))
                {
                    <a class="nav-link @(activePage == "usuarios" ? "active" : "")" aria-label="Usuarios" asp-controller="Usuarios" asp-action="Index" aria-current="@(activePage == "usuarios" ? "page" : null)">
                        <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2 3 6v6c0 5 5 8 9 10 4-2 9-5 9-10V6z M8 12l3 3 5-6" /></svg></span><span>Usuarios</span>
                    </a>
                }
            </nav>
            <div class="sidebar-footer"><span class="status-dot"></span> Sistema de gestión</div>
        </aside>
        <div class="main-area">
            <header class="topbar">
                <button class="menu-toggle" id="menuToggle" type="button" aria-label="Abrir menú" aria-controls="sidebar" aria-expanded="false">☰</button>
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="user-menu" aria-label="Usuario actual">
                    <span class="avatar" aria-hidden="true">@((User.Identity?.Name ?? "OV").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.FirstOrDefault())</span>
                    <span class="user-copy"><strong>@User.Identity?.Name</strong><small>@role</small></span>
                </div>
                <form method="post" asp-controller="Cuenta" asp-action="CerrarSesion" class="logout-form">
                    <button class="text-button logout-button" type="submit">Salir</button>
                </form>
            </header>
            <main class="content" id="mainContent">
                @RenderBody()
                <p class="demo-note"><span aria-hidden="true">i</span> Clientes ya usa PostgreSQL. Las demás pantallas siguen en desarrollo.</p>
            </main>
        </div>
    </div>
    <div class="sidebar-scrim" id="sidebarScrim"></div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

